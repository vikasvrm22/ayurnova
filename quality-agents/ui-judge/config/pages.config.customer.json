{
  "_comment": "Customer Auth + E2E journey audit scope. Separate from pages.config.json so it doesn't disturb the admin storageState wiring already configured there. Paths resolve relative to this file.",
  "baseUrl": "http://localhost:5100",
  "sourceRoots": ["../../../admin", "../../../public-site"],
  "designRefDir": "../../../public-site/design-ref",
  "auth": { "storageState": "../.auth/customer-storageState.json", "_note": "Not committed (gitignored, like the admin one). Regenerate by logging in as a disposable confirmed test customer through the real UI and saving context.storageState() before auditing any requiresAuth page below." },
  "pages": [
    {
      "name": "customer-login",
      "route": "/account",
