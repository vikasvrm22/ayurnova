# ---- Server ----
# This single server serves the API, the SSR public site, and the static
# admin panel together - there is no separate "frontend" port. 5100 (not
# 3000/4000/8000) to stay clear of other common local dev defaults on a
# shared machine. Change freely - nothing else hardcodes this value.
PORT=5100
# REQUIRED in every environment (Phase 9A P0-3) - the server refuses to
# start without a real value here (min 32 chars, not this placeholder).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long
# Single origin, "*", or a comma-separated list. Same-origin browser usage
# (the normal case - visiting http://localhost:$PORT/ and /admin) never
# triggers a CORS check at all; this only matters if you preview
# admin/public-site HTML via a separate static file server on another port.
CORS_ORIGIN=http://localhost:5100,http://localhost:3100,http://localhost:3101
# Public URL where this site is reachable - used in canonical links, sitemap,
# and Open Graph tags. Change to your real domain before going live.
SITE_BASE_URL=http://localhost:5100

# ---- Supabase ----
# From your Supabase project: Settings -> API
#   Project URL           -> SUPABASE_URL
#   anon / public key      -> SUPABASE_ANON_KEY   (safe to expose to browsers - protected by RLS)
#   service_role key       -> SUPABASE_SERVICE_ROLE_KEY  (SECRET - server only, bypasses RLS - never expose this)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Storage bucket name for product images (create this bucket in Supabase - see SETUP.md)
SUPABASE_STORAGE_BUCKET=product-images

# ---- Integration credential encryption (Phase 2) ----
# REQUIRED in every environment (Phase 9A P0-3) - encrypts Razorpay/SMS/
# email/WhatsApp credentials at rest in integration_configs (AES-256-GCM,
# see server/src/integrations/crypto.js). The server refuses to start
# without a real value here (min 32 chars, not this placeholder). Any
# string works (it's hashed to 32 bytes internally) but must be random and
# secret - never reuse JWT_SECRET's value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value after credentials have already been saved makes
# them permanently undecryptable - re-enter them via Admin -> Integrations
# if you ever rotate it.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-real-random-secret-at-least-32-characters-long

# ---- First Super Admin (used by `npm run seed-admin`) ----
SEED_SUPERADMIN_EMAIL=admin@ayurvedastore.example
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# ---- Shipping / checkout defaults (also editable via Admin -> Settings) ----
FREE_SHIPPING_THRESHOLD=599
PREPAID_DISCOUNT_PERCENT=2

# ---- Analytics ----
ANALYTICS_FLUSH_INTERVAL_MS=30000
ANALYTICS_MAX_BUFFER=500

# ---- SSR page cache ----
# How long a rendered page is served from memory before being rebuilt from
# the database. 5 minutes (300000) keeps hosting costs down (fewer database
# reads = less billed CPU/usage on Railway/Render) at the cost of a newly
# published product taking up to this long to appear. Lower it (e.g. 30000)
# if you publish very frequently and want changes to show up faster.
SSR_CACHE_TTL_MS=300000
